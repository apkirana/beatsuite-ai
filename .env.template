# Beat Suite AI - Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# --- Secrets -----------------------------------------------------------------

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Flask session signing key. REQUIRED — the app refuses to start without it
# unless FLASK_ENV=development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Server ------------------------------------------------------------------

# "development" relaxes the SECRET_KEY requirement. Anything else is treated
# as a real deployment.
FLASK_ENV=production

# Debug mode exposes an interactive console that executes arbitrary code.
# Leave this false anywhere reachable from a network.
FLASK_DEBUG=false

PORT=5001

# --- Browser security --------------------------------------------------------

# Comma-separated list of origins allowed to call the API with credentials.
# Must not be "*" — cookies are sent cross-origin.
ALLOWED_ORIGINS=http://localhost:5001

# Send session cookies only over HTTPS. Set to false ONLY for local http://.
SESSION_COOKIE_SECURE=true
